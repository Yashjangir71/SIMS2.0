# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your actual MongoDB Atlas credentials
MONGODB_URI=MONGODB_URI = process.env.MONGODB_URI || 'mongodb://localhost:27017/smart_inventory';

# JWT Secret Key (change this to a random secure string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
PORT=3000
